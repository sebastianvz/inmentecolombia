    <!-- Interactive Client Scripts -->
    <script is:inline>
        lucide.createIcons();

        function showPage(pageId) {
            const homeView = document.getElementById('page-home');
            const metricsView = document.getElementById('page-metrics');

            if (pageId === 'metrics') {
                homeView.classList.add('hidden');
                metricsView.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                metricsView.classList.add('hidden');
                homeView.classList.remove('hidden');
                if (window.location.hash) {
                    const elem = document.querySelector(window.location.hash);
                    if (elem) elem.scrollIntoView({ behavior: 'smooth' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const btnNav = document.getElementById('btn-show-metrics-nav');
            const btnHero = document.getElementById('btn-show-metrics-hero');
            const btnLink = document.getElementById('btn-show-metrics-link');
            const btnBack = document.getElementById('btn-back-home');
            const logoHome = document.getElementById('nav-home-logo');

            if (btnNav) btnNav.addEventListener('click', () => showPage('metrics'));
            if (btnHero) btnHero.addEventListener('click', () => showPage('metrics'));
            if (btnLink) btnLink.addEventListener('click', () => showPage('metrics'));
            if (btnBack) btnBack.addEventListener('click', () => showPage('home'));
            if (logoHome) logoHome.addEventListener('click', (e) => { e.preventDefault(); showPage('home'); });
        });
    </script>
