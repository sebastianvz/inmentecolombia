---
// InMente Landing Page - Componente de Astro
const title = "InMente | Tutorías Escolares y Universitarias en Colombia";
const description = "Tutorías personalizadas presenciales y virtuales en Colombia. Más de 10 años de experiencia acompañando el éxito académico de tus hijos.";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- CDN Tailwind CSS & Lucide Icons -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandBlue: '#1ca3e1',
                        brandPink: '#e4177a',
                        brandGreen: '#c3d92a',
                        brandDark: '#121e2b',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .edu-pattern-bg {
            background-color: #fafbfd;
            background-image: url('/Patrón.jpg');
            background-repeat: repeat;
            background-size: auto;
        }
        .text-gradient {
            background: linear-gradient(135deg, #1ca3e1 0%, #e4177a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .pulse-subtle {
            animation: pulse-slow 3s infinite ease-in-out;
        }
        @keyframes pulse-slow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
    </style>
</head>
<body class="font-sans text-slate-800 bg-slate-50 antialiased selection:bg-[#e4177a] selection:text-white flex flex-col min-h-screen">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" id="nav-home-logo" class="flex items-center gap-3 group">
                <img src="/logo.png" alt="InMente Logo" class="h-12 w-auto object-contain" />
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 font-medium text-slate-600 text-sm">
                <a href="#como-funciona" class="hover:text-[#1ca3e1] transition-colors">¿Cómo funciona?</a>
                <a href="#cobertura" class="hover:text-[#1ca3e1] transition-colors">Modalidades</a>
                <a href="#tutores" class="hover:text-[#1ca3e1] transition-colors">Nuestros Tutores</a>
                <button id="btn-show-metrics-nav" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-[#1ca3e1]/10 hover:text-[#1ca3e1] font-medium transition-all flex items-center gap-1.5">
                    <i data-lucide="bar-chart-3" class="w-4 h-4 text-[#e4177a]"></i>
                    <span>+10 Años en Cifras</span>
                </button>
            </nav>

            <!-- Direct CTA Header -->
            <a href="https://wa.me/573045470759?text=Hola,%20estoy%20interesado%20en%20agendar%20una%20clase" target="_blank" rel="noopener noreferrer" 
               class="hidden sm:inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm px-5 py-2.5 rounded-full shadow-md shadow-emerald-500/20 hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
                <i data-lucide="message-circle" class="w-4 h-4"></i>
                <span>Agendar por WhatsApp</span>
            </a>
        </div>
    </header>

    <main class="flex-grow">

        <!-- ==================== HOME PAGE VIEW ==================== -->
        <div id="page-home" class="transition-opacity duration-300">
            
            <!-- Hero Section -->
            <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden edu-pattern-bg">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="grid lg:grid-cols-12 gap-12 items-center">
                        
                        <!-- Hero Left Text Content -->
                        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
                            
                            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#1ca3e1]/10 text-[#1ca3e1] font-semibold text-xs sm:text-sm tracking-wide border border-[#1ca3e1]/20">
                                <i data-lucide="award" class="w-4 h-4 text-[#e4177a]"></i>
                                <span>Más de 10 Años de Experiencia en Colombia</span>
                            </div>

                            <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                                Si no cuentas con el tiempo suficiente para realizar las actividades escolares con tu hijo, <span class="text-gradient">nosotros te ayudamos.</span>
                            </h1>

                            <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0">
                                Te ofrecemos el respaldo pedagógico experto que tu hijo necesita para entender sus materias a su propio ritmo, recuperando la tranquilidad y la armonía en casa sin estresarte.
                            </p>

                            <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                                <a href="https://wa.me/573045470759?text=Hola,%20estoy%20interesado%20en%20agendar%20una%20clase" 
                                   target="_blank" rel="noopener noreferrer"
                                   class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-lg shadow-emerald-500/30 hover:shadow-xl transition-all duration-200 transform hover:-translate-y-1 pulse-subtle">
                                    <i data-lucide="message-circle" class="w-6 h-6"></i>
                                    <span>Agendar primera clase</span>
                                </a>
                                
                                <button id="btn-show-metrics-hero" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-base px-6 py-4 rounded-2xl border border-slate-200 shadow-sm transition-all">
                                    <i data-lucide="sparkles" class="w-5 h-5 text-[#1ca3e1]"></i>
                                    <span>Conocer nuestro impacto</span>
                                </button>
                            </div>

                            <div class="pt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-slate-200/80 max-w-xl mx-auto lg:mx-0 text-left">
                                <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-700">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-[#c3d92a] flex-shrink-0"></i>
                                    <span>Presencial y Virtual</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-700">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-[#e4177a] flex-shrink-0"></i>
                                    <span>Todas las materias</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-700">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-[#1ca3e1] flex-shrink-0"></i>
                                    <span>Tutores calificados</span>
                                </div>
                            </div>
                        </div>

                        <!-- Hero Right Graphic Display -->
                        <div class="lg:col-span-5 flex justify-center">
                            <div class="relative w-full max-w-md">
                                <div class="absolute -top-4 -bottom-4 -left-4 -right-4 bg-gradient-to-tr from-[#1ca3e1]/20 via-[#e4177a]/20 to-[#c3d92a]/20 rounded-3xl blur-2xl -z-10"></div>
                                
                                <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/60 space-y-6">
                                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-12 rounded-2xl bg-[#1ca3e1]/10 flex items-center justify-center text-[#1ca3e1]">
                                                <i data-lucide="book-open" class="w-6 h-6"></i>
                                            </div>
                                            <div>
                                                <h3 class="font-heading font-bold text-slate-900">Solución Escolar</h3>
                                                <p class="text-xs text-slate-500">Apoyo a tu medida</p>
                                            </div>
                                        </div>
                                        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-full">Activo</span>
                                    </div>

                                    <div class="space-y-3">
                                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-[#e4177a]/10 text-[#e4177a] flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="clock" class="w-4 h-4"></i>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-slate-800">Cero estrés de horarios</p>
                                                <p class="text-[11px] text-slate-500">Nos adaptamos a tu disponibilidad</p>
                                            </div>
                                        </div>

                                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-[#1ca3e1]/10 text-[#1ca3e1] flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="user-check" class="w-4 h-4"></i>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-slate-800">Tutor ideal asignado</p>
                                                <p class="text-[11px] text-slate-500">Pedagogía según cada estilo de aprendizaje</p>
                                            </div>
                                        </div>

                                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-[#c3d92a]/20 text-slate-800 flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="graduation-cap" class="w-4 h-4 text-emerald-700"></i>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-slate-800">Todos los grados y materias</p>
                                                <p class="text-[11px] text-slate-500">Primaria, Bachillerato y Universitarios</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-4 rounded-2xl bg-gradient-to-r from-[#1ca3e1] to-sky-600 text-white space-y-2">
                                        <p class="text-xs font-medium text-[#c3d92a]">¿Necesitas resolver una duda rápida?</p>
                                        <p class="text-sm font-semibold">Chatea directamente con nuestro equipo académico por WhatsApp</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Authority & Key Metrics Banner -->
            <section class="py-12 bg-white border-y border-slate-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
                        <div class="space-y-1 p-4 rounded-2xl hover:bg-slate-50 transition-all">
                            <p class="font-heading text-3xl sm:text-4xl font-extrabold text-[#1ca3e1]">+10 Años</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600">De Trayectoria Educativa (2015-2025)</p>
                        </div>
                        <div class="space-y-1 p-4 rounded-2xl hover:bg-slate-50 transition-all">
                            <p class="font-heading text-3xl sm:text-4xl font-extrabold text-[#e4177a]">+6,030</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600">Clases Impartidas con Éxito</p>
                        </div>
                        <div class="space-y-1 p-4 rounded-2xl hover:bg-slate-50 transition-all">
                            <p class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900">8,499+</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600">Horas de Tutoría Personalizada</p>
                        </div>
                        <div class="space-y-1 p-4 rounded-2xl hover:bg-slate-50 transition-all">
                            <p class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-800">162</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600">Colegios y Universidades Atendidos</p>
                        </div>
                    </div>

                    <div class="mt-8 text-center">
                        <button id="btn-show-metrics-link" class="inline-flex items-center gap-2 text-sm font-semibold text-[#1ca3e1] hover:text-[#e4177a] transition-colors underline underline-offset-4">
                            <span>Ver el desglose detallado de instituciones y materias dictadas</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- 3 Simple Steps Section -->
            <section id="como-funciona" class="py-20 bg-slate-50 relative">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
                        <span class="text-xs font-bold uppercase tracking-widest text-[#e4177a]">Proceso ágil y sin complicaciones</span>
                        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900">
                            ¿Cómo agendar la tutoría para tu hijo en 3 pasos?
                        </h2>
                        <p class="text-slate-600">
                            Sabemos que tu tiempo es valioso. Nos encargamos de todo el proceso de organización y emparejamiento académico.
                        </p>
                    </div>

                    <div class="grid md:grid-cols-3 gap-8 relative">
                        <!-- Step 1 -->
                        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between">
                            <div class="space-y-4">
                                <div class="w-14 h-14 rounded-2xl bg-[#1ca3e1]/10 text-[#1ca3e1] font-heading font-extrabold text-2xl flex items-center justify-center">1</div>
                                <h3 class="font-heading font-bold text-xl text-slate-900">Escríbenos tu Requerimiento</h3>
                                <p class="text-slate-600 text-sm leading-relaxed">
                                    Haz clic en el botón de WhatsApp y cuéntanos la materia, tema o tarea en la que tu hijo requiere apoyo.
                                </p>
                            </div>
                            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-medium text-[#1ca3e1]">
                                <i data-lucide="message-square" class="w-4 h-4"></i>
                                <span>Respuesta rápida garantizada</span>
                            </div>
                        </div>

                        <!-- Step 2 -->
                        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between">
                            <div class="space-y-4">
                                <div class="w-14 h-14 rounded-2xl bg-[#e4177a]/10 text-[#e4177a] font-heading font-extrabold text-2xl flex items-center justify-center">2</div>
                                <h3 class="font-heading font-bold text-xl text-slate-900">Asignamos al Tutor Ideal</h3>
                                <p class="text-slate-600 text-sm leading-relaxed">
                                    Buscamos al docente con la disponibilidad y pedagogía perfecta según la materia y el grado académico.
                                </p>
                            </div>
                            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-medium text-[#e4177a]">
                                <i data-lucide="user-check" class="w-4 h-4"></i>
                                <span>Filtro de calidad académica</span>
                            </div>
                        </div>

                        <!-- Step 3 -->
                        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition-all relative flex flex-col justify-between">
                            <div class="space-y-4">
                                <div class="w-14 h-14 rounded-2xl bg-[#c3d92a]/20 text-slate-900 font-heading font-extrabold text-2xl flex items-center justify-center">3</div>
                                <h3 class="font-heading font-bold text-xl text-slate-900">¡Tu Hijo Aprende con Tranquilidad!</h3>
                                <p class="text-slate-600 text-sm leading-relaxed">
                                    Se imparte la sesión (virtual o presencial) reforzando sus conocimientos mientras tú recuperas tu tiempo.
                                </p>
                            </div>
                            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-medium text-emerald-600">
                                <i data-lucide="check-circle" class="w-4 h-4"></i>
                                <span>Cero preocupaciones</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Modalities & Coverage Section -->
            <section id="cobertura" class="py-16 bg-white border-t border-slate-100">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="bg-gradient-to-br from-sky-50/80 via-slate-50 to-pink-50/30 rounded-3xl p-8 sm:p-12 border border-slate-200/80 relative overflow-hidden shadow-sm">
                        <div class="grid lg:grid-cols-12 gap-8 items-center relative z-10">
                            <div class="lg:col-span-7 space-y-4">
                                <span class="px-3 py-1 rounded-full bg-[#1ca3e1]/10 text-[#1ca3e1] text-xs font-bold tracking-wider uppercase border border-[#1ca3e1]/20">Modalidades Disponibles</span>
                                <h2 class="font-heading text-2xl sm:text-3xl font-bold text-slate-900">¿Cómo y dónde dictamos nuestras tutorías?</h2>
                                <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                                    Diseñamos cada modalidad para garantizar la máxima concentración, adaptándonos al grado de cada estudiante y la ubicación geográfica.
                                </p>
                            </div>

                            <div class="lg:col-span-5 space-y-4">
                                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-start gap-4">
                                    <div class="p-3 bg-[#1ca3e1]/10 text-[#1ca3e1] rounded-xl flex-shrink-0">
                                        <i data-lucide="map-pin" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-slate-900 text-base">Clases Presenciales</h3>
                                        <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                            Cobertura en <strong class="text-slate-900">Medellín y Sur del Valle de Aburrá</strong> (hasta Sabaneta).
                                        </p>
                                    </div>
                                </div>

                                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-start gap-4">
                                    <div class="p-3 bg-[#e4177a]/10 text-[#e4177a] rounded-xl flex-shrink-0">
                                        <i data-lucide="laptop" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-slate-900 text-base">Clases Virtuales</h3>
                                        <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                            Cobertura en <strong class="text-slate-900">toda Colombia</strong>. Recomendado para estudiantes de <strong class="text-slate-900">9 años en adelante</strong>.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tutors & Educational Quality Section -->
            <section id="tutores" class="py-20 bg-slate-50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="grid lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-6 space-y-6">
                            <span class="text-xs font-bold uppercase tracking-widest text-[#1ca3e1]">Respaldo Pedagógico</span>
                            <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 leading-tight">
                                Profesionales apasionados por la enseñanza y el progreso de tu hijo
                            </h2>
                            <p class="text-slate-600 text-base leading-relaxed">
                                En InMente nos aseguramos de que cada tutor no solo domine la materia a la perfección, sino que posea la empatía y paciencia necesarias para conectar con el estudiante.
                            </p>
                        </div>

                        <div class="lg:col-span-6 grid sm:grid-cols-2 gap-4">
                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                                <div class="w-10 h-10 rounded-xl bg-[#1ca3e1]/10 text-[#1ca3e1] flex items-center justify-center font-bold">
                                    <i data-lucide="calculator" class="w-5 h-5"></i>
                                </div>
                                <h3 class="font-heading font-bold text-slate-900">Matemáticas y Ciencias</h3>
                                <p class="text-xs text-slate-500">Álgebra, Cálculo, Física y Química explicados desde cero y sin complicaciones.</p>
                            </div>

                            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                                <div class="w-10 h-10 rounded-xl bg-[#e4177a]/10 text-[#e4177a] flex items-center justify-center font-bold">
                                    <i data-lucide="languages" class="w-5 h-5"></i>
                                </div>
                                <h3 class="font-heading font-bold text-slate-900">Idiomas y Lenguaje</h3>
                                <p class="text-xs text-slate-500">Inglés, comprensión lectora, redacción y apoyo en asignaturas Bilingües.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>

        <!-- ==================== METRICS SUBPAGE VIEW ==================== -->
        <div id="page-metrics" class="hidden transition-opacity duration-300 py-12 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
                <div class="flex items-center justify-between">
                    <button id="btn-back-home" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-[#1ca3e1] transition-colors bg-white px-4 py-2 rounded-xl border border-slate-200 shadow-sm">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        <span>Volver a la Página Principal</span>
                    </button>
                    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#1ca3e1]/10 text-[#1ca3e1]">
                        Informe de Gestión Histórico (2015 - 2025)
                    </span>
                </div>

                <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-3">
                    <h1 class="font-heading text-3xl font-extrabold text-slate-900">
                        Indicadores de Impacto Educativo InMente
                    </h1>
                    <p class="text-slate-600 text-sm max-w-3xl leading-relaxed">
                        Durante más de una década, InMente ha prestado servicios de tutoría personalizada a alumnos de 162 instituciones educativas diferentes (colegios y universidades).
